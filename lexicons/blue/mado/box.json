{
  "lexicon": 1,
  "id": "blue.mado.box",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Mado question box. Lives in the owner's repo.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["slug", "title", "isOpen", "publicKeyHex", "createdAt"],
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 64,
            "description": "URL-safe identifier for the box, unique within the owner's repo."
          },
          "title": {
            "type": "string",
            "maxLength": 600,
            "maxGraphemes": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1800,
            "maxGraphemes": 300
          },
          "isOpen": {
            "type": "boolean",
            "description": "Whether the box currently accepts new questions."
          },
          "publicKeyHex": {
            "type": "string",
            "description": "Hex-encoded ECIES (secp256k1) public key. Senders encrypt their DID against this; only the owner holds the matching private key."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
