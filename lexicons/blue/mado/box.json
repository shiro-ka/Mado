{
  "lexicon": 1,
  "id": "blue.mado.box",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["slug", "title", "isOpen", "createdAt"],
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 600,
            "maxGraphemes": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1800,
            "maxGraphemes": 300
          },
          "isOpen": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
