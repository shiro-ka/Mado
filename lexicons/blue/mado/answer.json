{
  "lexicon": 1,
  "id": "blue.mado.answer",
  "defs": {
    "main": {
      "type": "record",
      "description": "An answer to a blue.mado.koe question. Written to the box owner's repo.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["koe", "body", "createdAt"],
        "properties": {
          "koe": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the blue.mado.koe being answered."
          },
          "body": {
            "type": "string",
            "maxLength": 6000,
            "maxGraphemes": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
